server:
  retentionPeriod: 14d
  # Use with 30G pvc
  # retentionDiskSpaceUsage: 25

  persistentVolume:
    enabled: true
    storageClassName: longhorn-double-replica
    size: 30Gi

  serviceMonitor:
    enabled: true

vector:
  enabled: true

dashboards:
  enabled: true
  labels:
    grafana_dashboard: "1"

app-template:
  global:
    alwaysAppendIdentifierToResourceName: true

  route:
    main:
      annotations:
        gethomepage.dev/enabled: "true"
        gethomepage.dev/description: Logs
        gethomepage.dev/group: Monitoring
        gethomepage.dev/icon: sh-victorialogs
        gethomepage.dev/name: VictoriaLogs
        gethomepage.dev/app: victorialogs
        gethomepage.dev/pod-selector: "app.kubernetes.io/name=victoria-logs-single"
      rules:
        - backendRefs:
          - name: vm-logs-victoria-logs-single-server
            port: 9428
