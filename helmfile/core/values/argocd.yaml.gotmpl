global:
  domain: argocd.{{ requiredEnv "DOMAIN" }}

configs:
  cm:
    admin.enabled: false
    oidc.config: |
      name: Vault
      issuer: https://vault.{{ requiredEnv "DOMAIN" }}/v1/identity/oidc/provider/main
      clientID: $argocd-oidc:client_id
      clientSecret: $argocd-oidc:client_secret
      cliClientID: $argocd-oidc-cli:client_id
      requestedScopes:
        - openid
        - groups
        - email
  rbac:
    policy.default: 'role:admin'

  # TODO: get rid of this part, when cert-manager certificate generation is added in the upstream chart
  # Currently there's no built-in way to restart repo server automatically after cert rotation
  params:
    # We terminate TLS on ingress' level
    server.insecure: true

server:
  httproute:
    enabled: true
    annotations:
      gethomepage.dev/enabled: "true"
      gethomepage.dev/description: GitOps management system for Kubernetes
      gethomepage.dev/group: Cluster
      gethomepage.dev/icon: argocd.png
      gethomepage.dev/name: ArgoCD
    parentRefs:
      - name: envoy-gateway-main
        namespace: envoy-gateway
    hostnames:
      - argocd.{{ requiredEnv "DOMAIN" }}

# TODO: Experimental in chart, not yet fully supported
#  grpcroute:
#    enabled: true
#    parentRefs:
#      - name: envoy-gateway-main
#        namespace: envoy-gateway
#    hostnames:
#      - grpc.argocd.{{ requiredEnv "DOMAIN" }}

repoServer:
  volumes:
    - emptyDir: {}
      name: helmfile-cmp-tmp
  extraContainers:
    - name: helmfile-plugin
      # image: travisghansen/argo-cd-helmfile:v0.3.11
      # image: ghcr.io/b1-systems/argo-cd-helmfile:v0.3.15
      image: ghcr.io/dezeroku/argo-cd-helmfile@sha256:d1edf46631d4d1b8e6de859cbc5b3da8db878c09147501ec0b6f358d5f7810a5
      command: [/var/run/argocd/argocd-cmp-server]
      securityContext:
        runAsNonRoot: true
        runAsUser: 999
      volumeMounts:
        - mountPath: /var/run/argocd
          name: var-files
        - mountPath: /home/argocd/cmp-server/plugins
          name: plugins
        - mountPath: /tmp
          name: helmfile-cmp-tmp

dex:
  enabled: false

app-template:
  global:
    createDefaultServiceAccount: false

  rawResources:
    vault-auth:
      manifest:
        apiVersion: secrets.hashicorp.com/v1beta1
        kind: VaultAuth
        spec:
          method: kubernetes
          mount: k8s/homeserver
          kubernetes:
            role: argocd
            serviceAccount: argocd-server
    credentials-homelab:
      manifest:
        apiVersion: secrets.hashicorp.com/v1beta1
        kind: VaultStaticSecret
        spec:
          type: kv-v2
          mount: kvv2
          path: core/argocd/credentials/homelab
          destination:
            name: credentials-homelab
            labels:
              argocd.argoproj.io/secret-type: repository
            create: true
          vaultAuthRef: argocd-vault-auth
    credentials-helmfile-lib:
      manifest:
        apiVersion: secrets.hashicorp.com/v1beta1
        kind: VaultStaticSecret
        spec:
          type: kv-v2
          mount: kvv2
          path: core/argocd/credentials/helmfile-lib
          destination:
            name: credentials-helmfile-lib
            labels:
              argocd.argoproj.io/secret-type: repository
            create: true
          vaultAuthRef: argocd-vault-auth
    oidc:
      manifest:
        apiVersion: secrets.hashicorp.com/v1beta1
        kind: VaultStaticSecret
        spec:
          type: kv-v1
          mount: /identity
          path: oidc/client/argocd
          destination:
            name: argocd-oidc
            create: true
            labels:
              app.kubernetes.io/part-of: argocd
            transformation:
              includes:
                - client_id
                - client_secret
          vaultAuthRef: argocd-vault-auth
    oidc-cli:
      manifest:
        apiVersion: secrets.hashicorp.com/v1beta1
        kind: VaultStaticSecret
        spec:
          type: kv-v1
          mount: /identity
          path: oidc/client/argocd-cli
          destination:
            name: argocd-oidc-cli
            create: true
            labels:
              app.kubernetes.io/part-of: argocd
            transformation:
              includes:
                - client_id
          vaultAuthRef: argocd-vault-auth
