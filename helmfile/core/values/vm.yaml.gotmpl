# K3S specific stuff,
# taken from https://github.com/k3s-io/k3s/issues/3619
# Unfortunately hardcoded IPs, so just disable these for now
# Disabling these disables a lot of the monitoring...
# But it's on a best-effort basis
kubeControllerManager:
  enabled: false
kubeScheduler:
  enabled: false
kubeProxy:
  enabled: false

victoria-metrics-operator:
  enabled: false

alertmanager:
  config:
    route:
      # Basically do not group at all
      # we don't get that many alerts
      group_by: ['...']
      receiver: default
      routes:
      - receiver: pagerduty
        matchers:
          - alertname !~ "InfoInhibitor|Watchdog"
      - receiver: deadman
        group_wait: 0s
        group_interval: 1m
        repeat_interval: 50s
        matchers:
          - alertname = Watchdog
    receivers:
    - name: default
    - name: pagerduty
      pagerduty_configs:
      - routing_key_file: /etc/vm/secrets/vm-alertmanager-pagerduty-token/token
        send_resolved: true
    - name: deadman
      webhook_configs:
      - url_file: /etc/vm/secrets/vm-alertmanager-deadmanssnitch-url/url
  spec:
    externalURL: https://alertmanager.{{ requiredEnv "DOMAIN" }}
    secrets:
    - vm-alertmanager-pagerduty-token
    - vm-alertmanager-deadmanssnitch-url
    storage:
      volumeClaimTemplate:
        spec:
          accessModes:
            - ReadWriteOnce
          storageClassName: longhorn
          resources:
            requests:
              storage: 5Gi

grafana:
  # We disable the admin account creation via grafana.ini
  # This value is added here just to avoid unnecessary secret changes
  adminPassword: admin

  envValueFrom:
    GF_AUTH_GENERIC_OAUTH_CLIENT_ID:
      secretKeyRef:
        name: vm-grafana-oidc-secret
        key: client_id
    GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET:
      secretKeyRef:
        name: vm-grafana-oidc-secret
        key: client_secret
  defaultDashboardsTimezone: Europe/Warsaw
  sidecar:
    dashboards:
      searchNamespace: vm,vm-logs,cnpg
  plugins:
    - grafana-piechart-panel
  # TODO: new VM release doesn't like having both sidecar and configmaps provided dashboards
  # migrate these listed below to be compatible
  # dashboards:
  #   default:
  #     # Note: you can't have both sidecar and initContainer provisioning enabled,
  #     # this means that with this setup finding configMaps with dashboards won't be possible
  #     # built-in dashboards, not provisioned if initContainer provisioning is enabled
  #     victoria-metrics-cluster:
  #       gnetId: 11176
  #       revision: 39
  #       datasource: VictoriaMetrics
  #     vault:
  #       gnetId: 12904
  #       revision: 2
  #       datasource: VictoriaMetrics
  #     node-exporter-full:
  #       gnetId: 1860
  #       revision: 31
  #       datasource: VictoriaMetrics
  #     longhorn:
  #       gnetId: 16888
  #       rev: 8

  grafana.ini:
    # log:
    #  level: debug
    server:
      root_url: https://grafana.{{ requiredEnv "DOMAIN" }}
    security:
      disable_initial_admin_creation: true
    auth.generic_oauth:
      enabled: true
      name: Vault
      allow_sign_up: true
      auto_login: true
      scopes: "openid profile email groups"
      auth_url: https://vault.{{ requiredEnv "DOMAIN" }}/ui/vault/identity/oidc/provider/main/authorize
      token_url: https://vault.{{ requiredEnv "DOMAIN" }}/v1/identity/oidc/provider/main/token
      api_url: https://vault.{{ requiredEnv "DOMAIN" }}/v1/identity/oidc/provider/main/userinfo
      # These are set directly through env variables
      # client_id: ""
      # client_secret: ""
      role_attribute_path: contains(groups[*], 'vm') && 'GrafanaAdmin' || contains(groups[*], 'vm-grafana-editor') && 'Editor' || 'Viewer'
      allow_assign_grafana_admin: true

vmsingle:
  spec:
    resources:
      requests:
        memory: 1Gi
      limits:
        memory: 5Gi
    retentionPeriod: "30d"
    storage:
      accessModes:
        - ReadWriteOnce
      storageClassName: longhorn-double-replica
      resources:
        requests:
          storage: 75Gi
    extraArgs:
      maxLabelsPerTimeseries: "100"

vmagent:
  # Give it some room to breathe, defaults cause it to throttle
  # Maybe let's get rid of these completely?
  spec:
    resources:
      requests:
        cpu: 250m
      limits:
        cpu: 1

vmalert:
  spec:
    extraArgs:
      external.url: https://prometheus.{{ requiredEnv "DOMAIN" }}

app-template:
  global:
    alwaysAppendIdentifierToResourceName: true

  route:
    alertmanager:
      annotations:
        gethomepage.dev/enabled: "true"
        gethomepage.dev/description: Alerts routing
        gethomepage.dev/group: Monitoring
        gethomepage.dev/icon: sh-alertmanager
        gethomepage.dev/name: AlertManager
        gethomepage.dev/app: vmalertmanager
      rules:
        - backendRefs:
          - name: vmalertmanager-vm-victoria-metrics-k8s-stack
            port: 9093

    prometheus:
      annotations:
        gethomepage.dev/enabled: "true"
        gethomepage.dev/description: Metrics provider
        gethomepage.dev/group: Monitoring
        gethomepage.dev/icon: sh-victoriametrics
        gethomepage.dev/name: VictoriaMetrics
        gethomepage.dev/app: vmsingle
      rules:
        - backendRefs:
          - name: vmsingle-vm-victoria-metrics-k8s-stack
            port: 8428

    vmagent:
      annotations:
        gethomepage.dev/enabled: "true"
        gethomepage.dev/description: Metrics scraper
        gethomepage.dev/group: Monitoring
        gethomepage.dev/icon: sh-victoriametrics
        gethomepage.dev/name: VMAgent
        gethomepage.dev/app: vmagent
      rules:
        - backendRefs:
          - name: vmagent-vm-victoria-metrics-k8s-stack
            port: 8429

    grafana:
      annotations:
        gethomepage.dev/enabled: "true"
        gethomepage.dev/description: Dashboards
        gethomepage.dev/group: Monitoring
        gethomepage.dev/icon: sh-grafana
        gethomepage.dev/name: Grafana
        gethomepage.dev/app: grafana
      rules:
        - backendRefs:
          - name: vm-grafana
            port: 80

  rawResources:
    static-scrape:
      manifest:
        apiVersion: operator.victoriametrics.com/v1beta1
        kind: VMStaticScrape
        spec:
          jobName: node-exporter
          targetEndpoints:
            - targets:
                - devserver.lan:9100
                - 192.168.4.1:9100
                - dezeroku-desktop.lan:9100
    # Separate OIDC setup just for grafana
    vault-auth-grafana:
      manifest:
        apiVersion: secrets.hashicorp.com/v1beta1
        kind: VaultAuth
        spec:
          method: kubernetes
          mount: k8s/homeserver
          kubernetes:
            role: {{ .Release.Name }}-grafana
            serviceAccount: {{ .Release.Name }}-grafana
    grafana-oidc-secret:
      manifest:
        apiVersion: secrets.hashicorp.com/v1beta1
        kind: VaultStaticSecret
        spec:
          type: kv-v1
          mount: /identity
          path: oidc/client/{{ .Release.Name }}-grafana
          destination:
            name: {{ .Release.Name }}-grafana-oidc-secret
            create: true
            transformation:
              templates:
                client-id:
                  text: |-
                    {{ "{{`{{" }}.Secrets.client_id{{ "}}`}}" }}
                client-secret:
                  text: |-
                    {{ "{{`{{" }}.Secrets.client_secret{{ "}}`}}" }}
          vaultAuthRef: {{ .Release.Name }}-vault-auth-grafana
