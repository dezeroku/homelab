---
longhornUI:
  replicas: 1

metrics:
  serviceMonitor:
    enabled: true

persistence:
  defaultDataLocality: best-effort
  defaultDiskSelector:
    enable: true
    # That's the system drive
    selector: nvme

defaultSettings:
  # Use a dedicated network for data traffic
  storageNetwork: longhorn/longhorn-storage-net

  # Enabling this one is not trival and requires preparation, let's leave it using the default for now
  # It requires more IPs in the subnet
  # endpointNetworkForRWXVolume: longhorn/longhorn-storage-net

  defaultDataLocality: best-effort
  createDefaultDiskLabeledNodes: true
  # We set storageReserved on every disk level, that prevents too many volumes from being scheduled
  # This check in turn, prevent the replica to be scheduled BASED ON REAL DISK USAGE
  # Default is 25%, which is too much for the SSDs we run
  # Upstream recommends at least 25% for the system drives (we do 400Gs with storageReserved already)
  # Thus lowering it, especially for the SSDs
  storageMinimalAvailablePercentage: 5

  # Try to have roughly same number of replicas between nodes
  replicaAutoBalance: best-effort
  # After a while, let's switch to avoiding rebuilds
  # happening too often. It's 4 nodes anyway, with most of the
  # volumes being 3 replicas, so it's not like much can be balanced.
  # replicaAutoBalance: least-effort
  # There is a dedicated network for it now, let's use it

  # Region doesn't matter, but we have to set something for Longhorn to be happy
  backupTarget: s3://longhorn@us-east-1/
  backupTargetCredentialSecret: longhorn-minio-credentials-s3

  concurrentAutomaticEngineUpgradePerNodeLimit: 1
  # Default is 5, we should be able to live with 2-3 in case of upgrades
  # There is a dedicated network for it now, let's use it
  # concurrentReplicaRebuildPerNodeLimit: 1
  concurrentReplicaRebuildPerNodeLimit: 5

  # How many replicas can the sync pull from, anything >2 does not really make sense with 3 replicas
  rebuildConcurrentSyncLimit: 2

  # Wait an hour before dropping the replica,
  # default is 10 minutes, our drains usually take longer
  replicaReplenishmentWaitInterval: 3600

  # I suppose we want it? Introduced in 1.9.0
  # There are not offline volumes in the cluster though
  # offlineReplicaRebuilding: true

  # removeSnapshotsDuringFilesystemTrim: true

app-template:
  global:
    alwaysAppendIdentifierToResourceName: true

  route:
    main:
      annotations:
        gethomepage.dev/enabled: "true"
        gethomepage.dev/description: Distributed storage for Kubernetes
        gethomepage.dev/group: Cluster
        gethomepage.dev/icon: sh-longhorn
        gethomepage.dev/name: Longhorn
        gethomepage.dev/app: longhorn
      rules:
        - backendRefs:
          - name: longhorn-frontend
            port: 80
  rawResources:
    k8s-backups:
      manifest:
        apiVersion: longhorn.io/v1beta2
        kind: RecurringJob
        spec:
          cron: "0 1 * * *"
          task: "backup"
          groups:
          - k8s-backups
          retain: 2
          concurrency: 1
    daily-snapshot:
      manifest:
        apiVersion: longhorn.io/v1beta2
        kind: RecurringJob
        spec:
          cron: "0 1 * * *"
          task: "snapshot"
          groups:
          - daily-snapshot
          retain: 7
          concurrency: 3
    weekly-trim:
      manifest:
        apiVersion: longhorn.io/v1beta2
        kind: RecurringJob
        spec:
          cron: "0 3 * * 0"
          task: "filesystem-trim"
          # Simply all groups
          groups:
          - default
          - k8s-backups
          - daily-snapshot
          retain: 0
          concurrency: 2
    storage-net:
      manifest:
        apiVersion: k8s.cni.cncf.io/v1
        kind: NetworkAttachmentDefinition
        spec:
          config: |
            {
              "cniVersion": "0.3.1",
              "name": "longhorn-storage-net",
              "type": "macvlan",
              "master": "enp3s0",
              "mode": "bridge",
              "ipam": {
                "type": "whereabouts",
                "range": "192.168.14.16/28",
                "exclude": []
              }
            }
    scrape-network-policy:
      manifest:
        apiVersion: networking.k8s.io/v1
        kind: NetworkPolicy
        spec:
          podSelector:
            matchLabels:
              app: longhorn-manager
          policyTypes: [Ingress]
          ingress:
            - from:
                - namespaceSelector:
                    matchLabels:
                      kubernetes.io/metadata.name: victoria-metrics-stack
              ports:
                - port: 9500
                  protocol: TCP
