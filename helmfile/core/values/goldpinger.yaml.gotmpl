rbac:
  clusterscoped: false

extraEnv:
  - name: DISPLAY_NODENAME
    value: "true"

httpRoute:
  enabled: true
  annotations:
    gethomepage.dev/enabled: "true"
    gethomepage.dev/description: Inter-node connectivity
    gethomepage.dev/group: Monitoring
    gethomepage.dev/icon: si-planet
    gethomepage.dev/name: Goldpinger
    gethomepage.dev/app: goldpinger
  parentRefs:
    - name: envoy-gateway-main
      namespace: envoy-gateway
  hostnames:
    - goldpinger.{{ requiredEnv "DOMAIN" }}

resources:
  requests:
    cpu: 100m
    memory: 128Mi
  limits:
    cpu: 100m
    memory: 128Mi

serviceMonitor:
  enabled: true

prometheusRule:
  enabled: true
