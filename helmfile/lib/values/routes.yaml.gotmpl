---
# Routes for the release, attached to the shared Envoy gateway.
# Consumed via the `gateway` helmfile template.
#
# Driven by the release's `routes` map under `releaseConfig` in environment
# values (see the `environments:` part of the helmfile). Per route:
#
#   kind      - HTTPRoute (default), TCPRoute, GRPCRoute
#   hostname  - single hostname; defaults to <release>.<DOMAIN> for the route
#               named `main`, and to <route>.<release>.<DOMAIN> for any other
#   hostnames - explicit list, wins over `hostname`; set it to [] for a route
#               that takes none, e.g. a bare TCPRoute
#   service   - identifier of the service to send the traffic to. Only needed
#               when the release has more than one, in which case app-template
#               refuses to guess and every route has to say
#
# A release with no `routes` entry gets a single `main` route. Everything else
# about a route (rules, annotations, backendRefs) lives in the release's own
# values file, which is merged last and can override any of this.
#
# Labels:
#   chartRoot  - see base.yaml.gotmpl
{{- define "routes.body" }}
{{- $gateway := .Values.cluster.gateway }}
{{- $domain := requiredEnv "DOMAIN" }}
{{- $release := .Release.Name }}
{{- $routes := .Values | get (printf "releaseConfig.%s.routes" $release) (dict "main" dict) }}
route:
{{- range $name, $route := $routes }}
{{- $default := ternary (printf "%s.%s" $release $domain) (printf "%s.%s.%s" $name $release $domain) (eq $name "main") }}
{{- $hostnames := ternary ($route | get "hostnames" list) (list ($route | get "hostname" $default)) (hasKey $route "hostnames") }}
  {{ $name }}:
{{- with ($route | get "kind" "") }}
    kind: {{ . }}
{{- end }}
{{- if $hostnames }}
    hostnames:
{{-   range $hostnames }}
      - {{ . }}
{{-   end }}
{{- end }}
    parentRefs:
      - name: {{ $gateway.name }}
        namespace: {{ $gateway.namespace }}
{{- with ($route | get "service" "") }}
    rules:
      - backendRefs:
          - identifier: {{ . }}
{{- end }}
{{- end }}
{{- end }}
{{- $body := include "routes.body" . | trim }}
{{- $root := .Release.Labels | get "chartRoot" "" }}
{{- if $body }}
{{- if $root }}
{{ $root }}:
{{ $body | indent 2 }}
{{- else }}
{{ $body }}
{{- end }}
{{- end }}
