---
# A whole filebrowser instance: the container, its service, its config file and
# the volume for its user database. Access is OIDC-only, against Vault.
# Consumed via the `filebrowser` helmfile template, which also pulls in
# oidc-secret.yaml.gotmpl for the client credentials read below.
#
# The release brings the data to serve, by mounting it at /srv in its own
# values file:
#
#   persistence:
#     main:
#       enabled: true
#       type: persistentVolumeClaim
#       ...
#       advancedMounts:
#         filebrowser:
#           main:
#             - path: /srv
#
# Driven by the release's `filebrowser` map under `releaseConfig` in
# environment values (see the `environments:` part of the helmfile):
#
#   adminGroup    - OIDC group whose members are admins
#                                                  (default: <release>-admins)
#   readOnly      - true: users may browse and download, but not create,
#                   modify, delete or share            (default: false)
#   createUserDir - true: every user gets their own directory under /srv,
#                   rather than all of them sharing it (default: false)
#   config        - filebrowser config, deep-merged on top of everything the
#                   options above produce. For anything else the app can be
#                   told, e.g. `auth: {methods: {oidc: {scopes: "..."}}}`
#
# Labels:
#   chartRoot  - see base.yaml.gotmpl

# The config file itself, rendered as literal YAML and then merged with the
# release's `config` override. Keep it authored as YAML, not as dicts - it is
# the part of this block people actually read.
{{- define "filebrowser.config" }}
{{- $release := .Release.Name }}
{{- $cfg := .Values | get (printf "releaseConfig.%s.filebrowser" $release) dict }}
{{- $writable := not ($cfg | get "readOnly" false) }}
server:
  #logging:
  #  - levels: "info|warning|error"
  sources:
    - path: "/srv"
      config:
        defaultEnabled: true
        createUserDir: {{ $cfg | get "createUserDir" false }}
userDefaults:
  darkMode: true
  disableSettings: false
  account:
    permissions:
      admin: false
      api: false
      create: {{ $writable }}
      delete: {{ $writable }}
      modify: {{ $writable }}
      share: {{ $writable }}
auth:
  methods:
    password:
      enabled: false # only allow OIDC
    oidc:
      enabled: true
      issuerUrl: "{{ .Values.cluster.vault.oidcIssuer }}"
      scopes: "email openid profile groups"
      userIdentifier: "username"
      createUser: true
      adminGroup: {{ $cfg | get "adminGroup" (printf "%s-admins" $release) | quote }}
{{- end }}

{{- define "filebrowser.body" }}
{{- $cfg := .Values | get (printf "releaseConfig.%s.filebrowser" .Release.Name) dict }}
{{- $config := mergeOverwrite (fromYaml (include "filebrowser.config" .)) ($cfg | get "config" dict) }}
controllers:
  filebrowser:
    strategy: Recreate
    replicas: 1
    pod:
      securityContext:
        # Match the image's own user. Override this one path in the release's
        # values file when the data it serves is owned by somebody else.
        fsGroup: 1000
    containers:
      main:
        image:
          repository: ghcr.io/gtsteffaniak/filebrowser
          tag: 1.5.0-stable
          pullPolicy: IfNotPresent
        env:
          FILEBROWSER_DATABASE: /database/db.sql
          FILEBROWSER_CONFIG: /etc/filebrowser.yaml
          FILEBROWSER_OIDC_CLIENT_ID:
            valueFrom:
              secretKeyRef:
                name: {{ .Release.Name }}-oidc-secret
                key: client_id
          FILEBROWSER_OIDC_CLIENT_SECRET:
            valueFrom:
              secretKeyRef:
                name: {{ .Release.Name }}-oidc-secret
                key: client_secret
        probes:
          readiness:
            enabled: true
          liveness:
            enabled: true
        resources:
          limits:
            memory: 4Gi
          requests:
            memory: 256Mi
service:
  filebrowser:
    controller: filebrowser
    ports:
      http:
        port: 80
configMaps:
  config:
    enabled: true
    data:
      config.yaml: |
{{ toYaml $config | indent 8 }}
persistence:
  filebrowser-db:
    enabled: true
    type: persistentVolumeClaim
{{- with .Values.cluster.storageClass }}
    storageClass: {{ . }}
{{- end }}
    accessMode: ReadWriteOnce
    size: 1Gi
    advancedMounts:
      filebrowser:
        main:
          - path: /database
  config:
    enabled: true
    type: configMap
    identifier: config
    advancedMounts:
      filebrowser:
        main:
          - path: /etc/filebrowser.yaml
            subPath: config.yaml
{{- end }}
{{- $body := include "filebrowser.body" . | trim }}
{{- $root := .Release.Labels | get "chartRoot" "" }}
{{- if $body }}
{{- if $root }}
{{ $root }}:
{{ $body | indent 2 }}
{{- else }}
{{ $body }}
{{- end }}
{{- end }}
