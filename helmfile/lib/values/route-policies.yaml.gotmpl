---
# Gateway policies attached to the release's routes, one set per route that
# asks for them in its `releaseConfig` entry (see routes.yaml.gotmpl):
#
#   networks           - list of the network names defined below; their CIDRs
#                        are unioned into an allow rule, everything else denied
#   oidc               - true: the gateway authenticates the route against
#                        Vault. Needs the `oidc-secret` template inherited too,
#                        for the `<release>-oidc-secret` Secret referenced here
#   requestBufferLimit - request body buffer size, e.g. 10M
#
# Consumed via the `gateway` helmfile template. Both policies are L7, so they
# are only emitted for HTTP/GRPC routes.
#
# NOTE: requestBuffer alongside websocket upgrades is a known breaking point
# for envoy-gateway as of 2026 - don't set it on routes that upgrade to
# websockets (esphome, home-assistant, ...).
#
# Labels:
#   chartRoot  - see base.yaml.gotmpl
#
# The networks themselves are the cluster's, not the lib's - they come from
# `cluster.networks`, see lib/cluster-defaults.yaml.gotmpl.
{{- define "route-policies.body" }}
{{- $networks := .Values.cluster.networks }}
{{- $issuer := .Values.cluster.vault.oidcIssuer }}
{{- $domain := requiredEnv "DOMAIN" }}
{{- $release := .Release.Name }}
{{- $routes := .Values | get (printf "releaseConfig.%s.routes" $release) (dict "main" dict) }}
{{- $policed := dict }}
{{- range $name, $route := $routes }}
{{- if and (ne ($route | get "kind" "HTTPRoute") "TCPRoute")
           (or ($route | get "networks" list) ($route | get "oidc" false) ($route | get "requestBufferLimit" "")) }}
{{-   $_ := set $policed $name $route }}
{{- end }}
{{- end }}
{{- if $policed }}
rawResources:
{{- range $name, $route := $policed }}
{{- $kind := $route | get "kind" "HTTPRoute" }}
{{- $cidrs := list }}
{{- range $network := ($route | get "networks" list) }}
{{-   $cidrs = concat $cidrs (index $networks $network | required (printf "unknown network %q on route %s of release %s, known: %s" $network $name $release (keys $networks | sortAlpha | join ", ")) ) }}
{{- end }}
{{- if or $cidrs ($route | get "oidc" false) }}
  security-policy-{{ $name }}:
    manifest:
      apiVersion: gateway.envoyproxy.io/v1alpha1
      kind: SecurityPolicy
      spec:
        targetRefs:
          - group: gateway.networking.k8s.io
            kind: {{ $kind }}
            name: {{ $release }}-{{ $name }}
{{-   if $cidrs }}
        authorization:
          defaultAction: Deny
          rules:
            - action: Allow
              principal:
                clientCIDRs:
{{ $cidrs | uniq | sortAlpha | toYaml | indent 18 }}
{{-   end }}
{{-   if ($route | get "oidc" false) }}
{{-     $default := ternary (printf "%s.%s" $release $domain) (printf "%s.%s.%s" $name $release $domain) (eq $name "main") }}
{{-     $host := first (ternary ($route | get "hostnames" list) (list ($route | get "hostname" $default)) (hasKey $route "hostnames")) }}
        oidc:
          provider:
            issuer: "{{ $issuer }}"
          clientIDRef:
            name: "{{ $release }}-oidc-secret"
          clientSecret:
            name: "{{ $release }}-oidc-secret"
          redirectURL: "https://{{ $host }}/oauth2/callback"
{{-   end }}
{{- end }}
{{- with ($route | get "requestBufferLimit" "") }}
  backend-traffic-policy-{{ $name }}:
    manifest:
      apiVersion: gateway.envoyproxy.io/v1alpha1
      kind: BackendTrafficPolicy
      spec:
        targetRefs:
          - group: gateway.networking.k8s.io
            kind: {{ $kind }}
            name: {{ $release }}-{{ $name }}
        requestBuffer:
          limit: "{{ . }}"
{{- end }}
{{- end }}
{{- end }}
{{- end }}
{{- $body := include "route-policies.body" . | trim }}
{{- $root := .Release.Labels | get "chartRoot" "" }}
{{- if $body }}
{{- if $root }}
{{ $root }}:
{{ $body | indent 2 }}
{{- else }}
{{ $body }}
{{- end }}
{{- end }}
