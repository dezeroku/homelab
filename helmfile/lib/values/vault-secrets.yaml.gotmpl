---
# VaultStaticSecrets for the release, synced from the cluster's kv-v2 mount
# (`cluster.vault.secretsMount`, see lib/cluster-defaults.yaml.gotmpl).
# Consumed via the `vault-secrets` helmfile template, which also pulls in
# vault-auth.yaml.gotmpl for the vaultAuthRef below.
#
# Driven by the release's `secrets` list under `releaseConfig` in environment
# values (see the `environments:` part of the helmfile). Each entry is just the
# secret's name, and stands for the whole convention:
#
#   secrets: [jwt, key]        ->  Vault path     <prefix>/<release>/jwt
#                                  Secret         <release>-jwt
#                                  rawResources   secret-jwt
#
# A name may contain slashes for nested Vault paths (`users/control`); the
# Secret name flattens them to dashes (`<release>-users-control`).
#
# This is deliberately the minimal case. Anything more - a different mount, a
# transformation, refreshAfter - goes into the release's own values file under
# the same `rawResources` key, which is merged last on top of what's here.
#
# Labels:
#   chartRoot  - see base.yaml.gotmpl
{{- define "vault-secrets.body" }}
{{- $vault := .Values.cluster.vault }}
{{- $release := .Release.Name }}
{{- $secrets := .Values | get (printf "releaseConfig.%s.secrets" $release) list }}
{{- if $secrets }}
rawResources:
{{- range $name := $secrets }}
  secret-{{ $name | replace "/" "-" }}:
    manifest:
      apiVersion: secrets.hashicorp.com/v1beta1
      kind: VaultStaticSecret
      spec:
        type: kv-v2
        mount: {{ $vault.secretsMount }}
        path: {{ $vault.secretsPathPrefix }}/{{ $release }}/{{ $name }}
        destination:
          name: {{ $release }}-{{ $name | replace "/" "-" }}
          create: true
        vaultAuthRef: {{ $release }}-vault-auth
{{- end }}
{{- end }}
{{- end }}
{{- $body := include "vault-secrets.body" . | trim }}
{{- $root := .Release.Labels | get "chartRoot" "" }}
{{- if $body }}
{{- if $root }}
{{ $root }}:
{{ $body | indent 2 }}
{{- else }}
{{ $body }}
{{- end }}
{{- end }}
