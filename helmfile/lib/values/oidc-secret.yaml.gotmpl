---
# VaultStaticSecret holding the release's OIDC client credentials, synced from
# the Vault identity mount. Consumed via the `oidc-secret` helmfile template,
# which also pulls in vault-auth.yaml.gotmpl for the vaultAuthRef below.
#
# Inherit this template both when the app does its own OIDC (reading the secret
# from the env/config) and alongside `gateway`, for routes with `oidc: true`
# where the gateway authenticates in front of the app instead.
#
# Labels:
#   chartRoot  - see base.yaml.gotmpl
{{- define "oidc-secret.body" }}
rawResources:
  oidc-secret:
    manifest:
      apiVersion: secrets.hashicorp.com/v1beta1
      kind: VaultStaticSecret
      spec:
        type: kv-v1
        mount: {{ .Values.cluster.vault.identityMount }}
        path: oidc/client/{{ .Release.Name }}
        destination:
          name: {{ .Release.Name }}-oidc-secret
          create: true
          transformation:
            templates:
              client-id:
                text: |-
                  {{ "{{`{{" }}.Secrets.client_id{{ "}}`}}" }}
              client-secret:
                text: |-
                  {{ "{{`{{" }}.Secrets.client_secret{{ "}}`}}" }}
        vaultAuthRef: {{ .Release.Name }}-vault-auth
{{- end }}
{{- $body := include "oidc-secret.body" . | trim }}
{{- $root := .Release.Labels | get "chartRoot" "" }}
{{- if $body }}
{{- if $root }}
{{ $root }}:
{{ $body | indent 2 }}
{{- else }}
{{ $body }}
{{- end }}
{{- end }}
