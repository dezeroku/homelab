---
# Shared VaultAuth, consumed via the `vault` (or `vault-secrets`, `oidc-secret`)
# helmfile template.
#
# Labels:
#   vaultRole            - Vault k8s auth role       (default: release name)
#   vaultServiceAccount  - ServiceAccount to bind to (default: release name)
#   chartRoot            - see base.yaml.gotmpl
{{- define "vault-auth.body" }}
rawResources:
  vault-auth:
    manifest:
      apiVersion: secrets.hashicorp.com/v1beta1
      kind: VaultAuth
      spec:
        method: kubernetes
        mount: {{ .Values.cluster.vault.kubernetesMount | required "cluster.vault.kubernetesMount is unset - see lib/cluster-defaults.yaml.gotmpl" }}
        kubernetes:
          role: {{ .Release.Labels | get "vaultRole" .Release.Name }}
          serviceAccount: {{ .Release.Labels | get "vaultServiceAccount" .Release.Name }}
{{- end }}
{{- $body := include "vault-auth.body" . | trim }}
{{- $root := .Release.Labels | get "chartRoot" "" }}
{{- if $body }}
{{- if $root }}
{{ $root }}:
{{ $body | indent 2 }}
{{- else }}
{{ $body }}
{{- end }}
{{- end }}
