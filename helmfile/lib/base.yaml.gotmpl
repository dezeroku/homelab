---
# Everything the fragments below need to know about the cluster, as
# `.Values.cluster.*`: the lib's defaults first, then the repository's own
# answers from the `cluster.yaml.gotmpl` sitting next to the helmfile
# directories. A directory that needs to differ overrides the same keys in its
# own `environments:` block, which is merged after both.
environments:
  default:
    values:
      - ../lib/cluster-defaults.yaml.gotmpl
      - ../cluster.yaml.gotmpl

templates:
  default:
    namespace: "{{`{{ .Release.Name }}`}}"
    values:
      - values/{{`{{ .Release.Name }}`}}.yaml.gotmpl
  # Opt-in building blocks. Inherit these *before* `default`, so that a
  # release's own values file always wins on conflict.
  #
  # They all emit values for app-template. When the release points at
  # app-template directly that means top-level keys, which is the default. When
  # it points at a wrapper chart that has app-template as a *dependency*, set
  # the `chartRoot` label on the release to the dependency's name and every
  # fragment nests itself one level deeper instead:
  #
  #   - name: something-enhancements
  #     chart: ../charts/something-enhancements
  #     labels:
  #       chartRoot: app-template
  vault:
    values:
      - ../lib/values/vault-auth.yaml.gotmpl
  # Everything gateway-side for a release: its routes on the shared Envoy
  # gateway, plus the SecurityPolicy / BackendTrafficPolicy attached to them.
  # Entirely driven by the release's `routes` map under `releaseConfig` in the
  # helmfile's `environments:` part - inherit this, describe the routes there.
  gateway:
    values:
      - ../lib/values/routes.yaml.gotmpl
      - ../lib/values/route-policies.yaml.gotmpl
  # The release's plain Vault secrets, one VaultStaticSecret per name listed in
  # its `secrets` list under `releaseConfig` in the helmfile's `environments:`
  # part. Only covers the by-convention case - see vault-secrets.yaml.gotmpl.
  vault-secrets:
    values:
      - ../lib/values/vault-auth.yaml.gotmpl
      - ../lib/values/vault-secrets.yaml.gotmpl
  # The release's OIDC client credentials from Vault. Needed both by apps that
  # do their own OIDC and by routes with `oidc: true`, which have the gateway
  # authenticate in front of the app.
  oidc-secret:
    values:
      - ../lib/values/vault-auth.yaml.gotmpl
      - ../lib/values/oidc-secret.yaml.gotmpl
  # A complete filebrowser instance, OIDC-only against Vault - hence the
  # oidc-secret block below it. The release only has to mount what it should
  # serve at /srv; see filebrowser.yaml.gotmpl for the `filebrowser` options
  # (adminGroup, readOnly) under `releaseConfig`.
  filebrowser:
    values:
      - ../lib/values/vault-auth.yaml.gotmpl
      - ../lib/values/oidc-secret.yaml.gotmpl
      - ../lib/values/filebrowser.yaml.gotmpl
  # MeTube, named after itself throughout so it can either be a release of its
  # own or ride along in one that already runs something else. Needs a route
  # pointing at its service - see metube.yaml.gotmpl.
  metube:
    values:
      - ../lib/values/metube.yaml.gotmpl
  argocd-app:
    namespace: argocd
    labels:
      argocd-app: true
    chart: ../lib/charts/argocd-app
    version: 0.1.0
    values:
      - domain: '{{ requiredEnv "DOMAIN" }}'
        helmfileDirectory: '{{ exec "git" (list "rev-parse" "--show-prefix") }}'
        repoURL: '{{ exec "git" (list "ls-remote" "--get-url" "origin") }}'
