---
# homepage: see ../helmfile.yaml.gotmpl for what these keys mean.
releaseConfig:
  homepage:
    chart: bjw-s-labs/app-template
    version: 5.0.1
    templates: [gateway, vault]
    routes:
      main:
        hostname: '{{ requiredEnv "DOMAIN" }}'
        networks: [lan, guest, vpn_main, vpn_guest, vpn_family]
