---
# flatnotes: see ../helmfile.yaml.gotmpl for what these keys mean.
releaseConfig:
  bambuddy:
    chart: bjw-s-labs/app-template
    version: 5.0.1
    templates: [gateway, oidc-secret, postgres]
    postgres:
      serverName: bambuddy-v1
      recover: true
    routes:
      main:
        networks: [lan, guest, vpn_main]
        service: main
