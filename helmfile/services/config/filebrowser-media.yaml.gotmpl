---
# filebrowser-media: see ../helmfile.yaml.gotmpl for what these keys mean.
releaseConfig:
  filebrowser-media:
    chart: bjw-s-labs/app-template
    version: 5.0.1
    templates: [gateway, filebrowser]
    namespace: media
    filebrowser:
      adminGroup: filebrowser-media
    routes:
      main:
        networks: [lan, guest]
        hostname: filebrowser.media.home.dezeroku.com
