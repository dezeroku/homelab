---
# kopia: see ../helmfile.yaml.gotmpl for what these keys mean.
releaseConfig:
  kopia:
    chart: bjw-s-labs/app-template
    version: 5.0.1
    templates: [gateway, vault-secrets]
    secrets:
      - pushover
      - repository
    routes:
      main:
        hostname: 'kopia.tls.{{ requiredEnv "DOMAIN" }}'
        service: main
        kind: TLSRoute
