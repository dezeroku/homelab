---
# minecraft: see ../helmfile.yaml.gotmpl for what these keys mean.
releaseConfig:
  minecraft:
    chart: itzg/minecraft
    version: 4.24.0
    templates: [gateway, vault-secrets]
    secrets: [rcon]
    routes:
      main:
        kind: TCPRoute
        networks: [lan, guest, vpn_main, vpn_guest, vpn_family]
    labels:
      chartRoot: app-template
    dependencies:
      - chart: bjw-s-labs/app-template
        version: 5.0.1
