---
# zot: see ../helmfile.yaml.gotmpl for what these keys mean.
releaseConfig:
  zot:
    chart: zot/zot
    version: 0.1.134
    templates: [gateway]
    labels:
      chartRoot: app-template
    routes:
      main:
        networks: [lan, vpn_main, cluster]
    dependencies:
      - chart: bjw-s-labs/app-template
        version: 5.0.1
