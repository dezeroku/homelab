---
# ente: see ../helmfile.yaml.gotmpl for what these keys mean.
releaseConfig:
  ente:
    chart: bjw-s-labs/app-template
    version: 5.0.1
    templates: [gateway, vault-secrets, postgres]
    secrets: [jwt-secret, key]
    postgres:
      database: ente
      superuser: true
      serverName: ente-v1
      recover: true
    routes:
      auth:
        hostname: 'auth.ente.{{ requiredEnv "DOMAIN" }}'
        networks: [lan, guest, vpn_main, vpn_guest, vpn_family]
        service: auth
      api:
        hostname: 'api.ente.{{ requiredEnv "DOMAIN" }}'
        networks: [lan, guest, vpn_main, vpn_guest, vpn_family]
        service: server
