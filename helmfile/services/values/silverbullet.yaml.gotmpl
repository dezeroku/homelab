---
global:
  alwaysAppendIdentifierToResourceName: true

defaultPodOptions:
  securityContext:
    runAsUser: 1000
    runAsGroup: 1000
    fsGroup: 1000
controllers:
  main:
    type: deployment
    replicas: 1
    containers:
      main:
        image:
          repository: ghcr.io/silverbulletmd/silverbullet
          tag: 2.9.0
          pullPolicy: IfNotPresent
        probes:
          liveness: &probe
            enabled: true
          readiness: *probe
          startup: *probe
        resources:
          limits:
            # Indexing can use quite a lot
            memory: 2Gi
          requests:
            memory: 512Mi

service:
  main:
    controller: main
    ports:
      http:
        port: 3000

route:
  main:
    annotations:
      gethomepage.dev/enabled: "true"
      gethomepage.dev/description: Knowledge Base
      gethomepage.dev/group: Utils
      gethomepage.dev/icon: sh-silverbullet
      gethomepage.dev/name: silverbullet
      gethomepage.dev/pod-selector: "app.kubernetes.io/name=silverbullet"

persistence:
  storage:
    enabled: true
    type: persistentVolumeClaim
    storageClass: longhorn-ssd
    accessMode: ReadWriteOnce
    size: 1Gi
    globalMounts:
      - path: /space
