# TODO: enable auth (Vault based?), currently it's just an IP allowlist

metrics:
  enabled: true
  serviceMonitor:
    enabled: true

pvc:
  create: true
  storage: 50Gi
  storageClassName: longhorn-ssd

app-template:
  global:
    alwaysAppendIdentifierToResourceName: true

  route:
    main:
      rules:
        - backendRefs:
          - name: zot
            port: 5000
