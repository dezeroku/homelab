---
global:
  alwaysAppendIdentifierToResourceName: true

# TODO: attach emptyDirs in required places and run as non-root
#defaultPodOptions:
#  securityContext:
#    runAsUser: 19972
#    runAsGroup: 19972
#    fsGroup: 19972

controllers:
  main:
    #strategy: Recreate
    replicas: 1
    containers:
      main:
        image:
          repository: ghcr.io/librespeed/speedtest
          tag: 6.2.0
          pullPolicy: IfNotPresent
        env:
          MODE: standalone
        probes:
          readiness:
            enabled: true
          liveness:
            enabled: true
        resources:
          limits:
            memory: 512Mi
          requests:
            memory: 128Mi

service:
  main:
    controller: main
    ports:
      http:
        port: 8080

route:
  main:
    annotations:
      gethomepage.dev/enabled: "true"
      gethomepage.dev/description: Measure transfer speed
      gethomepage.dev/group: Tools
      gethomepage.dev/icon: sh-librespeed
      gethomepage.dev/name: SpeedTest
      gethomepage.dev/pod-selector: "app.kubernetes.io/name=speedtest"
