image:
  tag: 2026.8.0-java25-jdk

resources:
  requests:
    memory: 12Gi
    cpu: 1
  limits:
    memory: 15Gi
    cpu: 10

minecraftServer:
  # Uncomment this when applying changes to configs
  # overrideServerProperties: true
  eula: true
  version: "26.2"
  #type: SPIGOT
  # difficulty: normal
  # whitelist: dezeroku
  ops: dezeroku
  maxWorldSize: 100000
  viewDistance: 32
  gameMode: survival
  motd: "Welcome to the League of Minecraft"
  memory: 12G
  worldSaveName: 26.2
  # jvmOpts: ""
  # jvmXXOpts: "-Xmx12G -Xms12G"

  rcon:
    enabled: true
    existingSecret: minecraft-rcon
    secretKey: password

persistence:
  storageClass: longhorn
  dataDir:
    enabled: true
    Size: 10Gi

app-template:
  global:
    alwaysAppendIdentifierToResourceName: true

  route:
    main:
      rules:
        - backendRefs:
            - name: minecraft-minecraft
              port: 25565
