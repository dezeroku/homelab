---
global:
  alwaysAppendIdentifierToResourceName: true

defaultPodOptions:
  securityContext:
    runAsUser: 1000
    runAsGroup: 1000
    fsGroup: 1000
controllers:
  main:
    type: deployment
    replicas: 1
    containers:
      main:
        image:
          repository: dullage/flatnotes
          tag: v5.5.4
          pullPolicy: IfNotPresent
        env:
          TZ: Europe/Warsaw
          # Controlled on ingress level, single user scenario
          FLATNOTES_AUTH_TYPE: none
        probes:
          liveness: &probe
            enabled: true
          readiness: *probe
          startup: *probe
        resources:
          limits:
            memory: 256Mi
          requests:
            memory: 50Mi

service:
  main:
    controller: main
    ports:
      http:
        port: 8080

persistence:
  storage:
    enabled: true
    type: persistentVolumeClaim
    storageClass: longhorn
    accessMode: ReadWriteOnce
    size: 1Gi
    globalMounts:
      - path: /data
