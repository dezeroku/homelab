---
global:
  alwaysAppendIdentifierToResourceName: true

controllers:
  main:
    type: deployment
    strategy: Recreate
    replicas: 1
    pod:
      securityContext:
        fsGroup: 10001
      annotations:
        k8s.v1.cni.cncf.io/networks: {{ .Release.Name }}-iot-net
    containers:
      api:
        image:
          repository: ghcr.io/jfmlima/shelly-manager-api
          tag: 1.10.0
          pullPolicy: IfNotPresent
        env:
          TZ: Europe/Warsaw
          SHELLY_SECRET_KEY:
            valueFrom:
              secretKeyRef:
                name: {{ .Release.Name }}-secret-key
                key: value
          SHELLY_AUTH_TOKEN:
            valueFrom:
              secretKeyRef:
                name: {{ .Release.Name }}-auth-token
                key: value
          # TODO: IoT devices seem to generate
          # WARNING: Invalid HTTP request received
          # while trying to update via the manager?
          # Maybe they just use too old software already
          SHELLY_FIRMWARE_ADVERTISED_BASE_URL: "192.168.3.91:8000"
        probes:
          liveness: &probe
            enabled: true
          readiness: *probe
          startup: *probe
      web:
        image:
          repository: ghcr.io/jfmlima/shelly-manager-web
          tag: 1.10.0
          pullPolicy: IfNotPresent
        env:
          TZ: Europe/Warsaw
          VITE_BASE_API_URL: https://api-{{ .Release.Name }}.{{ requiredEnv "DOMAIN" }}
        probes:
          liveness: &probe
            enabled: true
          readiness: *probe
          startup: *probe

service:
  api:
    controller: main
    ports:
      http:
        port: 8000
  web:
    controller: main
    ports:
      http:
        port: 8080

route:
  main:
    annotations:
      gethomepage.dev/enabled: "true"
      gethomepage.dev/description: Shelly Manager
      gethomepage.dev/group: IoT
      gethomepage.dev/icon: sh-shelly
      gethomepage.dev/name: Shelly Manager
      gethomepage.dev/pod-selector: "app.kubernetes.io/name={{ .Release.Name }}"

persistence:
  data:
    enabled: true
    type: persistentVolumeClaim
    storageClass: longhorn
    accessMode: ReadWriteOnce
    size: 1Gi
    advancedMounts:
      main:
        api:
          - path: /data

rawResources:
  iot-net:
    manifest:
      apiVersion: "k8s.cni.cncf.io/v1"
      kind: NetworkAttachmentDefinition
      spec:
        config: '{
          "cniVersion": "0.3.1",
          "type": "macvlan",
          "master": "enp2s0.30",
          "mode": "bridge",
          "ipam": {
            "type": "static",
            "addresses": [
              {
                "address": "192.168.3.91/24",
                "gateway": "192.168.3.1"
              }
            ]
          }
        }'
