---
global:
  alwaysAppendIdentifierToResourceName: true

# defaultPodOptions:
#   securityContext:
#     runAsUser: 1000
#     runAsGroup: 1000
#     fsGroup: 1000
controllers:
  main:
    type: deployment
    replicas: 1
    serviceAccount:
      identifier: main
    initContainers:
      include-common-secrets:
        image:
          repository: alpine
          tag: 3.24
          pullPolicy: IfNotPresent
        command:
          - /bin/sh
          - -c
          - |
            line='<<: !include /common-secrets/secrets.yaml'
            touch /config/secrets.yaml
            grep -qF "$line" /config/secrets.yaml || printf '%s\n' "$line" >> /config/secrets.yaml
    containers:
      main:
        image:
          repository: ghcr.io/esphome/esphome
          tag: 2026.6.4
          pullPolicy: IfNotPresent
        probes:
          liveness: &probe
            enabled: true
          readiness: *probe
          startup: *probe
        # resources:
        #   limits:
        #     memory: 24Gi
        #   requests:
        #     memory: 512Mi
service:
  main:
    controller: main
    ports:
      http:
        port: 6052

serviceAccount:
  main: {}

ingress:
  main:
    enabled: true
    className: nginx
    annotations:
      cert-manager.io/cluster-issuer: "cert-manager-letsencrypt-dns-prod"
      gethomepage.dev/enabled: "true"
      gethomepage.dev/description: ESP Home Device Builder
      gethomepage.dev/group: IoT
      gethomepage.dev/icon: esphome.png
      gethomepage.dev/name: esphome
      gethomepage.dev/pod-selector: "app.kubernetes.io/name=esphome"
      nginx.ingress.kubernetes.io/whitelist-source-range: "192.168.1.0/24,192.168.69.0/24"
      nginx.ingress.kubernetes.io/auth-url: "https://sso.{{ requiredEnv "DOMAIN" }}/oauth2/auth?allowed_emails=contact@dezeroku.com"
      nginx.ingress.kubernetes.io/auth-signin: "https://sso.{{ requiredEnv "DOMAIN" }}/oauth2/start?rd=https://$host$escaped_request_uri"
      # Arbitrary size of uploads
      nginx.ingress.kubernetes.io/proxy-body-size: "0"
    tls:
      - secretName: esphome-general-tls
        hosts:
          - esphome.{{ requiredEnv "DOMAIN" }}
    hosts:
      - host: esphome.{{ requiredEnv "DOMAIN" }}
        paths:
          - path: /
            pathType: ImplementationSpecific
            service:
              identifier: main

persistence:
  config:
    enabled: true
    type: persistentVolumeClaim
    storageClass: longhorn-ssd
    accessMode: ReadWriteOnce
    size: 1Gi
    globalMounts:
      - path: /config
  cache:
    enabled: true
    type: persistentVolumeClaim
    storageClass: longhorn-ssd-double-replica
    accessMode: ReadWriteOnce
    size: 15Gi
    globalMounts:
      - path: /config/.esphome
  common-secrets:
    enabled: true
    type: secret
    name: {{ .Release.Name }}-secrets
    globalMounts:
      - path: /common-secrets
        readOnly: true

rawResources:
  vault-auth:
    apiVersion: secrets.hashicorp.com/v1beta1
    kind: VaultAuth
    spec:
      spec:
        method: kubernetes
        mount: k8s/homeserver
        kubernetes:
          role: {{ .Release.Name }}
          serviceAccount: {{ .Release.Name }}-main
  secrets-secret:
    apiVersion: secrets.hashicorp.com/v1beta1
    kind: VaultStaticSecret
    spec:
      spec:
        type: kv-v2
        mount: kvv2
        path: services/{{ .Release.Name }}/secrets
        destination:
          name: {{ .Release.Name }}-secrets
          create: true
          transformation:
            templates:
              secrets.yaml:
                text: |
                  {{ "{{ `{{- range $k, $v := .Secrets }}` }}" }}
                  {{ "{{ `{{ $k }}: {{ $v | quote }}` }}" }}
                  {{ "{{ `{{- end }}` }}" }}
        vaultAuthRef: {{ .Release.Name }}-vault-auth
