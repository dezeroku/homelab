---
global:
  alwaysAppendIdentifierToResourceName: true

controllers:
  main:
    strategy: Recreate
    replicas: 1
    containers:
      main:
        image:
          repository: docker.getoutline.com/outlinewiki/outline
          tag: 1.10.1
          pullPolicy: IfNotPresent
        env:
          TZ: Europe/Warsaw

          URL: https://{{ .Release.Name }}.{{ requiredEnv "DOMAIN" }}

          # Using mailrise under the hood, not a real SMTP server
          SMTP_HOST: mailrise-main.mailrise
          SMTP_PORT: 8025
          SMTP_FROM: "Outline@dezeroku <outline@home.dezeroku.com>"

          SECRET_KEY:
            valueFrom:
              secretKeyRef:
                name: {{ .Release.Name }}-secret-key
                key: value
          UTILS_SECRET:
            valueFrom:
              secretKeyRef:
                name: {{ .Release.Name }}-utils-secret
                key: value

          DATABASE_URL:
            valueFrom:
              secretKeyRef:
                name: {{ .Release.Name }}-db-app
                key: uri

          REDIS_URL: redis://{{ .Release.Name }}-dragonfly-db:6379/0

          FILE_STORAGE: local
          FILE_STORAGE_UPLOAD_MAX_SIZE: 26214400
          FILE_STORAGE_IMPORT_MAX_SIZE: ""
          FILE_STORAGE_WORKSPACE_IMPORT_MAX_SIZE: ""

          OIDC_DISPLAY_NAME: Vault
          OIDC_ISSUER_URL: https://vault.{{ requiredEnv "DOMAIN" }}/v1/identity/oidc/provider/main
          OIDC_CLIENT_ID:
            valueFrom:
              secretKeyRef:
                name: {{ .Release.Name }}-oidc-secret
                key: client_id
          OIDC_CLIENT_SECRET:
            valueFrom:
              secretKeyRef:
                name: {{ .Release.Name }}-oidc-secret
                key: client_secret
        probes:
          readiness:
            enabled: true
          liveness:
            enabled: true

service:
  main:
    controller: main
    ports:
      http:
        port: 3000

persistence:
  config-storage:
    enabled: true
    type: persistentVolumeClaim
    storageClass: longhorn
    accessMode: ReadWriteOnce
    size: 1Gi
    # labels:
    #   recurring-job-group.longhorn.io/daily-snapshot: enabled
    #   recurring-job.longhorn.io/source: enabled
    globalMounts:
      - path: /var/lib/outline/data

route:
  main:
    annotations:
      gethomepage.dev/enabled: "true"
      gethomepage.dev/description: Wiki
      gethomepage.dev/group: Services
      gethomepage.dev/icon: sh-outline
      gethomepage.dev/name: Outline
      gethomepage.dev/pod-selector: "app.kubernetes.io/name={{ .Release.Name }}"

rawResources:
  dragonfly-db:
    manifest:
      apiVersion: dragonflydb.io/v1alpha1
      kind: Dragonfly
      spec:
        args:
          # Fix needed specifically for how Outline does it
          - --default_lua_flags=allow-undeclared-keys
        replicas: 1
        resources:
          requests:
            cpu: 50m
            memory: 128Mi
          limits:
            cpu: 250m
            memory: 512Mi
        snapshot:
          cron: "*/5 * * * *"
          persistentVolumeClaimSpec:
            accessModes:
            - ReadWriteOnce
            resources:
              requests:
                storage: 1Gi
            storageClassName: longhorn
  db:
    manifest:
      apiVersion: postgresql.cnpg.io/v1
      kind: Cluster
      spec:
        instances: 1
        imageName: ghcr.io/cloudnative-pg/postgresql:18
        storage:
          size: 1Gi
        backup:
          barmanObjectStore:
            destinationPath: s3://{{ .Release.Name }}/
            endpointURL: https://api.k8s-backups.minio.{{ requiredEnv "DOMAIN" }}
            s3Credentials:
              accessKeyId:
                name: {{ .Release.Name }}-cnpg-backup-s3-secret
                key: ACCESS_KEY_ID
              secretAccessKey:
                name: {{ .Release.Name }}-cnpg-backup-s3-secret
                key: ACCESS_SECRET_KEY
            wal:
              compression: gzip
          retentionPolicy: "14d"
  db-backup:
    manifest:
      apiVersion: postgresql.cnpg.io/v1
      kind: ScheduledBackup
      spec:
        schedule: "0 0 1 * * 0"
        backupOwnerReference: self
        cluster:
          name: {{ .Release.Name }}-db
  cnpg-backup-s3-secret:
    manifest:
      apiVersion: secrets.hashicorp.com/v1beta1
      kind: VaultStaticSecret
      spec:
        type: kv-v2
        mount: kvv2
        path: core/minio/k8s-backups/backuper-credentials
        destination:
          name: {{ .Release.Name }}-cnpg-backup-s3-secret
          create: true
          transformation:
            excludes:
              - .*
            templates:
              ACCESS_KEY_ID:
                text: |-
                  {{ "{{`{{" }}.Secrets.username{{ "}}`}}" }}
              ACCESS_SECRET_KEY:
                text: |-
                  {{ "{{`{{" }}.Secrets.password{{ "}}`}}" }}
        vaultAuthRef: {{ .Release.Name }}-vault-auth
