---
global:
  alwaysAppendIdentifierToResourceName: true

# defaultPodOptions:
#   securityContext:
#     runAsUser: 1000
#     runAsGroup: 1000
#     fsGroup: 1000
controllers:
  main:
    type: deployment
    replicas: 1
    containers:
      main:
        image:
          repository: ghcr.io/actualbudget/actual
          tag: 26.7.0
          pullPolicy: IfNotPresent
        probes:
          liveness: &probe
            enabled: true
          readiness: *probe
          startup: *probe
        env:
          ACTUAL_OPENID_DISCOVERY_URL: "https://vault.{{ requiredEnv "DOMAIN" }}/v1/identity/oidc/provider/main/.well-known/openid-configuration"
          ACTUAL_OPENID_CLIENT_ID:
            valueFrom:
              secretKeyRef:
                name: {{ .Release.Name }}-oidc-secret
                key: client_id
          ACTUAL_OPENID_CLIENT_SECRET:
            valueFrom:
              secretKeyRef:
                name: {{ .Release.Name }}-oidc-secret
                key: client_secret
          ACTUAL_OPENID_SERVER_HOSTNAME: https://{{ .Release.Name }}.{{ requiredEnv "DOMAIN" }}
          ACTUAL_OPENID_ENFORCE: "true"
          ACTUAL_USER_CREATION_MODE: login
        # resources:
        #   limits:
        #     memory: 24Gi
        #   requests:
        #     memory: 512Mi
service:
  main:
    controller: main
    ports:
      http:
        port: 5006

ingress:
  main:
    enabled: true
    className: nginx
    annotations:
      cert-manager.io/cluster-issuer: "cert-manager-letsencrypt-dns-prod"
      gethomepage.dev/enabled: "true"
      gethomepage.dev/description: Home Budgeting solution
      gethomepage.dev/group: Services
      gethomepage.dev/icon: {{ .Release.Name }}.png
      gethomepage.dev/name: Actual Budget
      gethomepage.dev/pod-selector: "app.kubernetes.io/name={{ .Release.Name }}"
      # Arbitrary size of uploads
      nginx.ingress.kubernetes.io/proxy-body-size: "0"
    tls:
      - secretName: {{ .Release.Name }}-tls
        hosts:
          - {{ .Release.Name }}.{{ requiredEnv "DOMAIN" }}
    hosts:
      - host: {{ .Release.Name }}.{{ requiredEnv "DOMAIN" }}
        paths:
          - path: /
            pathType: ImplementationSpecific
            service:
              identifier: main

persistence:
  data:
    enabled: true
    type: persistentVolumeClaim
    storageClass: longhorn-ssd
    accessMode: ReadWriteOnce
    size: 1Gi
    globalMounts:
      - path: /data

rawResources:
  vault-auth:
    manifest:
      apiVersion: secrets.hashicorp.com/v1beta1
      kind: VaultAuth
      spec:
        method: kubernetes
        mount: k8s/homeserver
        kubernetes:
          role: {{ .Release.Name }}
          serviceAccount: {{ .Release.Name }}
  oidc-secret:
    manifest:
      apiVersion: secrets.hashicorp.com/v1beta1
      kind: VaultStaticSecret
      spec:
        type: kv-v1
        mount: /identity
        path: oidc/client/{{ .Release.Name }}
        destination:
          name: {{ .Release.Name }}-oidc-secret
          create: true
          transformation:
            includes:
              - client_id
              - client_secret
        vaultAuthRef: {{ .Release.Name }}-vault-auth
