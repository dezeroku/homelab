---
global:
  alwaysAppendIdentifierToResourceName: true

controllers:
  web:
    strategy: Recreate
    replicas: 1
    containers:
      main:
        image:
          repository: ghcr.io/ente/web
          # September 2026
          tag: 1a623f325ad9b6ba68e23c1298eb6cf4486f27c8
          pullPolicy: IfNotPresent
        env:
          ENTE_API_ORIGIN: https://api.{{ .Release.Name }}.{{ requiredEnv "DOMAIN" }}
        probes:
          liveness:
            enabled: true
          readiness:
            enabled: true
          startup:
            enabled: true
        resources:
          limits:
            memory: 1Gi
  server:
    strategy: Recreate
    replicas: 1
    containers:
      main:
        image:
          repository: ghcr.io/ente/server
          # September 2026
          tag: 163f45c26f130090abed03649530f53d2d976565
          pullPolicy: IfNotPresent
        probes:
          liveness:
            enabled: true
          readiness:
            enabled: true
          startup:
            enabled: true
        resources:
          limits:
            memory: 1Gi
        env:
          ENTE_JWT_SECRET:
            valueFrom:
              secretKeyRef:
                name: {{ .Release.Name }}-jwt-secret
                key: secret
          ENTE_KEY_ENCRYPTION:
            valueFrom:
              secretKeyRef:
                name: {{ .Release.Name }}-key
                key: encryption
          ENTE_KEY_HASH:
            valueFrom:
              secretKeyRef:
                name: {{ .Release.Name }}-key
                key: hash
          ENTE_DB_USER:
            valueFrom:
              secretKeyRef:
                name: {{ .Release.Name }}-db-app
                key: user
          ENTE_DB_PASSWORD:
            valueFrom:
              secretKeyRef:
                name: {{ .Release.Name }}-db-app
                key: password
          ENTE_DB_NAME:
            valueFrom:
              secretKeyRef:
                name: {{ .Release.Name }}-db-app
                key: dbname
          ENTE_DB_HOST:
            valueFrom:
              secretKeyRef:
                name: {{ .Release.Name }}-db-app
                key: host
          ENTE_DB_SSLMODE: require
          ENTE_APPS_ACCOUNTS: http://ente-accounts:3001
          # Using mailrise under the hood, not a real SMTP server
          ENTE_SMTP_HOST: mailrise-main.mailrise
          ENTE_SMTP_PORT: 8025
          ENTE_SMTP_EMAIL: {{ .Release.Name }}@{{ requiredEnv "DOMAIN" }}
          ENTE_SMTP_SENDER_NAME: Ente@dezeroku

service:
  accounts:
    controller: web
    ports:
      http:
        port: 3001
  auth:
    controller: web
    ports:
      http:
        port: 3003
  server:
    controller: server
    ports:
      http:
        port: 8080

route:
  auth:
    annotations:
      gethomepage.dev/enabled: "true"
      gethomepage.dev/description: 2FA helper (ask me for help with setup)
      gethomepage.dev/group: Services
      gethomepage.dev/icon: sh-ente-auth
      gethomepage.dev/name: Ente Auth
      gethomepage.dev/pod-selector: "app.kubernetes.io/name={{ .Release.Name }}"
