---
global:
  alwaysAppendIdentifierToResourceName: true

controllers:
  web:
    strategy: Recreate
    replicas: 1
    containers:
      main:
        image:
          repository: ghcr.io/ente-io/web
          # January 2025
          tag: 460ee1671b08b119b894f0ddd71b4c906fb29647
          pullPolicy: IfNotPresent
        env:
          ENTE_API_ORIGIN: https://api.{{ .Release.Name }}.{{ requiredEnv "DOMAIN" }}
        probes:
          liveness:
            enabled: true
          readiness:
            enabled: true
          startup:
            enabled: true
        resources:
          limits:
            memory: 1Gi
  server:
    strategy: Recreate
    replicas: 1
    containers:
      main:
        image:
          repository: ghcr.io/ente-io/server
          # December 2025
          tag: fa30e7c7bf695b1af49b895a72e4de86fb791e09
          pullPolicy: IfNotPresent
        probes:
          liveness:
            enabled: true
          readiness:
            enabled: true
          startup:
            enabled: true
        resources:
          limits:
            memory: 1Gi
        env:
          ENTE_JWT_SECRET:
            valueFrom:
              secretKeyRef:
                name: {{ .Release.Name }}-jwt-secret
                key: secret
          ENTE_KEY_ENCRYPTION:
            valueFrom:
              secretKeyRef:
                name: {{ .Release.Name }}-key
                key: encryption
          ENTE_KEY_HASH:
            valueFrom:
              secretKeyRef:
                name: {{ .Release.Name }}-key
                key: hash
          ENTE_DB_USER:
            valueFrom:
              secretKeyRef:
                name: {{ .Release.Name }}-db-app
                key: user
          ENTE_DB_PASSWORD:
            valueFrom:
              secretKeyRef:
                name: {{ .Release.Name }}-db-app
                key: password
          ENTE_DB_NAME:
            valueFrom:
              secretKeyRef:
                name: {{ .Release.Name }}-db-app
                key: dbname
          ENTE_DB_HOST:
            valueFrom:
              secretKeyRef:
                name: {{ .Release.Name }}-db-app
                key: host
          ENTE_DB_SSLMODE: require
          ENTE_APPS_ACCOUNTS: http://ente-accounts:3001
          # Using mailrise under the hood, not a real SMTP server
          ENTE_SMTP_HOST: mailrise-main.mailrise
          ENTE_SMTP_PORT: 8025
          ENTE_SMTP_EMAIL: {{ .Release.Name }}@{{ requiredEnv "DOMAIN" }}
          ENTE_SMTP_SENDER_NAME: Ente@dezeroku

service:
  accounts:
    controller: web
    ports:
      http:
        port: 3001
  auth:
    controller: web
    ports:
      http:
        port: 3003
  server:
    controller: server
    ports:
      http:
        port: 8080

route:
  auth:
    annotations:
      gethomepage.dev/enabled: "true"
      gethomepage.dev/description: 2FA helper (ask me for help with setup)
      gethomepage.dev/group: Services
      gethomepage.dev/icon: sh-ente-auth
      gethomepage.dev/name: Ente Auth
      gethomepage.dev/pod-selector: "app.kubernetes.io/name={{ .Release.Name }}"

rawResources:
  db:
    manifest:
      apiVersion: postgresql.cnpg.io/v1
      kind: Cluster
      spec:
        instances: 1
        imageName: ghcr.io/cloudnative-pg/postgresql:17
        storage:
          size: 1Gi
        bootstrap:
          #initdb:
          #  database: ente
          #  owner: ente
          recovery:
            source: {{ .Release.Name }}-backup
            database: ente
            owner: ente
        managed:
          roles:
            - name: ente
              superuser: true
              login: true
        externalClusters:
          - name: {{ .Release.Name }}-backup
            barmanObjectStore:
              <<: &objstore
                serverName: {{ .Release.Name }}-v1

                destinationPath: s3://{{ .Release.Name }}/
                endpointURL: https://api.k8s-backups.minio.{{ requiredEnv "DOMAIN" }}
                s3Credentials:
                  accessKeyId:
                    name: {{ .Release.Name }}-cnpg-backup-s3-secret
                    key: ACCESS_KEY_ID
                  secretAccessKey:
                    name: {{ .Release.Name }}-cnpg-backup-s3-secret
                    key: ACCESS_SECRET_KEY
        backup:
          barmanObjectStore:
            <<: *objstore
            serverName: {{ .Release.Name }}-v1

            wal:
              compression: gzip
          retentionPolicy: "14d"
  db-backup:
    manifest:
      apiVersion: postgresql.cnpg.io/v1
      kind: ScheduledBackup
      spec:
        schedule: "0 0 1 * * *"
        backupOwnerReference: self
        cluster:
          name: {{ .Release.Name }}-db
  cnpg-backup-s3-secret:
    manifest:
      apiVersion: secrets.hashicorp.com/v1beta1
      kind: VaultStaticSecret
      spec:
        type: kv-v2
        mount: kvv2
        path: core/minio/k8s-backups/backuper-credentials
        destination:
          name: {{ .Release.Name }}-cnpg-backup-s3-secret
          create: true
          transformation:
            excludes:
              - .*
            templates:
              ACCESS_KEY_ID:
                text: |-
                  {{ "{{`{{" }}.Secrets.username{{ "}}`}}" }}
              ACCESS_SECRET_KEY:
                text: |-
                  {{ "{{`{{" }}.Secrets.password{{ "}}`}}" }}
        vaultAuthRef: {{ .Release.Name }}-vault-auth
