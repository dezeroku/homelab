---
bases:
  - ../lib/base.yaml.gotmpl

# Per-release configuration for the templates in ../lib: the routes a release
# exposes on the shared gateway, the policies on them, and its Vault secrets.
# See ../lib/values/routes.yaml.gotmpl and ../lib/values/route-policies.yaml.gotmpl
# for the accepted keys.
#
# One file per release under config/, globbed in below, so that adding or
# changing a release touches only its own file. A release inheriting `gateway`
# with no file gets a single `main` route at <release>.<DOMAIN> and no policies.
#
# These are *.yaml.gotmpl, not *.yaml: helmfile only treats an environment
# values file as a Go template when the extension says so, and the hostnames in
# them are built from the DOMAIN env var. A plain .yaml here renders the
# template syntax literally into the hostname.
environments:
  default:
    values:
      - config/*.yaml.gotmpl

---
helmDefaults:
  kubeContext: homeserver

repositories:
  - name: bjw-s-labs
    url: https://bjw-s-labs.github.io/helm-charts
  - name: minio
    url: https://operator.min.io/
  - name: itzg
    url: https://itzg.github.io/minecraft-server-charts/
  - name: zot
    url: http://zotregistry.dev/helm-charts
  - name: otwld
    url: https://helm.otwld.com/
releases:
{{- /*
  One app release per entry in releaseConfig, plus its argocd-app companion.
  Everything about a release lives in config/<name>.yaml.gotmpl; see the
  comment at the top of this file. `dig` rather than plain field access
  because helmfile renders with strict map lookup, so a missing optional key
  would otherwise be a hard error.
*/}}
{{- range $name, $cfg := .Values.releaseConfig }}
  - name: {{ $name }}
    chart: {{ $cfg.chart }}
    version: {{ $cfg.version }}
    {{- with dig "namespace" "" $cfg }}
    namespace: {{ . }}
    {{- end }}
    {{- with dig "labels" dict $cfg }}
    labels:
      {{- toYaml . | nindent 6 }}
    {{- end }}
    {{- with dig "dependencies" list $cfg }}
    dependencies:
      {{- toYaml . | nindent 6 }}
    {{- end }}
    {{- with dig "values" list $cfg }}
    values:
      {{- toYaml . | nindent 6 }}
    {{- end }}
    inherit:
      {{- range dig "templates" list $cfg }}
      - template: {{ . }}
      {{- end }}
      - template: default
  - name: {{ $name }}
    {{- with dig "namespace" "" $cfg }}
    values:
      - targetNamespace: {{ . }}
    {{- end }}
    inherit:
      - template: argocd-app
{{- end }}
