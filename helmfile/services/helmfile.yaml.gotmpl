---
bases:
  - ../lib/base.yaml.gotmpl

# Per-release gateway configuration for the `gateway` template: the routes a
# release exposes and the policies on them. See ../lib/values/routes.yaml.gotmpl
# and ../lib/values/route-policies.yaml.gotmpl for the accepted keys.
# Releases inheriting `gateway` with no entry here get a single `main` route at
# <release>.<DOMAIN> and no policies.
environments:
  default:
    values:
      - releaseConfig:
          redbot-main:
            routes:
              filebrowser:
                networks: [lan, vpn_main, vpn_guest, vpn_family]
                hostname: 'redbot-main-filebrowser.{{ requiredEnv "DOMAIN" }}'
                service: filebrowser
              metube:
                networks: [lan, vpn_main, vpn_guest, vpn_family]
                oidc: true
                hostname: 'redbot-main-metube.{{ requiredEnv "DOMAIN" }}'
                service: metube
          redbot-premiers:
            routes:
              filebrowser:
                networks: [lan, vpn_main, vpn_guest, vpn_family]
                hostname: 'redbot-premiers-filebrowser.{{ requiredEnv "DOMAIN" }}'
                service: filebrowser
              metube:
                networks: [lan, vpn_main, vpn_guest, vpn_family]
                oidc: true
                hostname: 'redbot-premiers-metube.{{ requiredEnv "DOMAIN" }}'
                service: metube
            filebrowser:
              adminGroup: redbot-admins
            metube:
              existingClaim: redbot-main-localtracks
              subPath: metube
          navidrome:
            routes:
              main:
                networks: [lan, guest, vpn_main, vpn_guest, vpn_family]
                service: main
              metube:
                networks: [lan, guest, vpn_main, vpn_guest, vpn_family]
                hostname: navidrome-metube.{{ requiredEnv "DOMAIN" }}
                oidc: true
                service: metube
          invidious:
            routes:
              main:
                networks: [lan, guest, vpn_main, vpn_guest, vpn_family]
            secrets: [hmac, companion-hmac]
          ryot:
            routes:
              main:
                networks: [lan, guest, cluster, vpn_main, vpn_guest, vpn_family]
            secrets: [admin]
          paperless:
            routes:
              main:
                networks: [lan, guest, vpn_main, vpn_guest, vpn_family]
            secrets: [ses/incoming, redis, admin, secret-key]
          immich-enhancements:
            routes:
              main:
                networks: [lan, guest, vpn_main, vpn_guest, vpn_family]
                hostname: immich.{{ requiredEnv "DOMAIN" }}
          hedgedoc:
            routes:
              main:
                networks: [lan, guest, cluster, vpn_main, vpn_guest, vpn_family]
          yopass:
            routes:
              main:
                networks: [lan, guest, vpn_main, vpn_guest, vpn_family]
          home-assistant:
            routes:
              main:
                networks: [lan, guest, vpn_main, vpn_family]
          stirling-pdf:
            routes:
              main:
                networks: [lan, guest, vpn_main, vpn_guest, vpn_family]
          it-tools:
            routes:
              main:
                networks: [lan, guest, vpn_main, vpn_guest, vpn_family]
          homepage:
            routes:
              main:
                hostname: '{{ requiredEnv "DOMAIN" }}'
                networks: [lan, guest, vpn_main, vpn_guest, vpn_family]
          speedtest:
            routes:
              main:
                networks: [lan, guest, vpn_main, vpn_guest, vpn_family]
          ente:
            routes:
              auth:
                hostname: 'auth.ente.{{ requiredEnv "DOMAIN" }}'
                networks: [lan, guest, vpn_main, vpn_guest, vpn_family]
              api:
                hostname: 'api.ente.{{ requiredEnv "DOMAIN" }}'
                networks: [lan, guest, vpn_main, vpn_guest, vpn_family]
          filebrowser-drive:
            filebrowser:
              createUserDir: true
            routes:
              main:
                networks: [lan, guest, vpn_main, vpn_guest, vpn_family]
                hostname: drive.{{ requiredEnv "DOMAIN" }}
          filebrowser-media:
            filebrowser:
              adminGroup: filebrowser-media
            routes:
              main:
                networks: [lan, guest]
                hostname: filebrowser.media.home.dezeroku.com
          filebrowser-media-readonly:
            filebrowser:
              adminGroup: filebrowser-media
              readOnly: true
            routes:
              main:
                networks: [lan, guest, vpn_main, vpn_guest, vpn_family]
                hostname: filebrowser-readonly.media.home.dezeroku.com
          convertx:
            routes:
              main:
                networks: [lan, guest, vpn_main, vpn_guest, vpn_family]
          cyberchef:
            routes:
              main: {}
          metube:
            metube:
              existingClaim: media-storage-main
              subPath: metube
            routes:
              main:
                service: metube
                networks: [lan, vpn_main, vpn_guest]
                oidc: true
          jellyfin:
            secrets: [ldap-bind-user]
            routes:
              main:
                # TODO: Is cluster really needed here?
                networks: [lan, guest, cluster, vpn_main, vpn_guest, vpn_family]
          change-detection:
            routes:
              main:
                networks: [lan, guest, vpn_main]
                oidc: true
          flatnotes:
            routes:
              main:
                networks: [lan, guest, vpn_main]
                oidc: true
          esphome:
            routes:
              main:
                networks: [lan, vpn_main]
                oidc: true
          actual-budget:
            routes:
              main: {}
          lldap:
            secrets: [jwt, key, user]
            routes:
              main:
                networks: [lan, vpn_main]
              # served at ldaps.lldap.<DOMAIN> by the naming convention
              ldaps:
                kind: TCPRoute
          mosquitto:
            routes:
              main:
                kind: TCPRoute

---
helmDefaults:
  kubeContext: homeserver

repositories:
  - name: bjw-s-labs
    url: https://bjw-s-labs.github.io/helm-charts
  - name: minio
    url: https://operator.min.io/
  - name: itzg
    url: https://itzg.github.io/minecraft-server-charts/
  - name: zot
    url: http://zotregistry.dev/helm-charts
releases:
  - name: pacoloco
    chart: bjw-s-labs/app-template
    version: 4.1.2
    inherit:
      - template: default
  - name: pacoloco
    inherit:
      - template: argocd-app

  - name: invidious
    chart: bjw-s-labs/app-template
    version: 5.0.1
    labels:
      vaultServiceAccount: invidious-main
    inherit:
      - template: gateway
      - template: vault-secrets
      - template: default
  - name: invidious
    inherit:
      - template: argocd-app

  - name: redbot-main
    chart: bjw-s-labs/app-template
    version: 5.0.1
    inherit:
      - template: filebrowser
      - template: metube
      - template: gateway
      - template: oidc-secret
      - template: default
    values:
      - values/redbot-common.yaml.gotmpl
  - name: redbot-main
    inherit:
      - template: argocd-app

  - name: redbot-premiers
    chart: bjw-s-labs/app-template
    version: 5.0.1
    inherit:
      - template: filebrowser
      - template: metube
      - template: gateway
      - template: oidc-secret
      - template: default
    values:
      - values/redbot-common.yaml.gotmpl
  - name: redbot-premiers
    inherit:
      - template: argocd-app

  - name: netbootxyz
    chart: bjw-s-labs/app-template
    version: 4.1.2
    inherit:
      - template: default
  - name: netbootxyz
    inherit:
      - template: argocd-app

  - name: home-assistant
    chart: bjw-s-labs/app-template
    version: 5.0.1
    inherit:
      - template: gateway
      - template: vault
      - template: default
  - name: home-assistant
    inherit:
      - template: argocd-app

  - name: media-storage
    namespace: media
    chart: bjw-s-labs/app-template
    version: 4.1.2
    inherit:
      - template: default
  - name: media-storage
    values:
      - targetNamespace: media
    inherit:
      - template: argocd-app

  - name: filebrowser-media
    namespace: media
    chart: bjw-s-labs/app-template
    version: 5.0.1
    inherit:
      - template: gateway
      - template: filebrowser
      - template: default
  - name: filebrowser-media
    values:
      - targetNamespace: media
    inherit:
      - template: argocd-app

  - name: filebrowser-media-readonly
    namespace: media
    chart: bjw-s-labs/app-template
    version: 5.0.1
    inherit:
      - template: gateway
      - template: filebrowser
      - template: default
  - name: filebrowser-media-readonly
    values:
      - targetNamespace: media
    inherit:
      - template: argocd-app

  - name: metube
    namespace: media
    chart: bjw-s-labs/app-template
    version: 5.0.1
    inherit:
      - template: metube
      - template: gateway
      - template: oidc-secret
      - template: default
  - name: metube
    values:
      - targetNamespace: media
    inherit:
      - template: argocd-app

  - name: jellyfin
    namespace: media
    chart: bjw-s-labs/app-template
    version: 5.0.1
    inherit:
      - template: gateway
      - template: vault-secrets
      - template: default
  - name: jellyfin
    values:
      - targetNamespace: media
    inherit:
      - template: argocd-app

  - name: minio-core
    chart: minio/tenant
    version: 7.0.0
    inherit:
      - template: default
    dependencies:
      - chart: bjw-s-labs/app-template
        version: 4.1.2
  - name: minio-core
    inherit:
      - template: argocd-app

  - name: minio-private
    chart: minio/tenant
    version: 7.0.0
    inherit:
      - template: default
    dependencies:
      - chart: bjw-s-labs/app-template
        version: 4.1.2
  - name: minio-private
    inherit:
      - template: argocd-app

  - name: homepage
    chart: bjw-s-labs/app-template
    version: 5.0.1
    inherit:
      - template: gateway
      - template: vault
      - template: default
  - name: homepage
    inherit:
      - template: argocd-app

  - name: paperless
    chart: bjw-s-labs/app-template
    version: 5.0.1
    inherit:
      - template: gateway
      - template: vault-secrets
      - template: oidc-secret
      - template: default
  - name: paperless
    inherit:
      - template: argocd-app

  - name: minecraft
    chart: itzg/minecraft
    version: 4.24.0
    inherit:
      - template: default
    dependencies:
      - chart: bjw-s-labs/app-template
        version: 4.1.2
  - name: minecraft
    inherit:
      - template: argocd-app

  - name: ryot
    chart: bjw-s-labs/app-template
    version: 5.0.1
    inherit:
      - template: gateway
      - template: vault-secrets
      - template: oidc-secret
      - template: default
  - name: ryot
    inherit:
      - template: argocd-app

  - name: hedgedoc
    chart: bjw-s-labs/app-template
    version: 5.0.1
    inherit:
      - template: gateway
      - template: oidc-secret
      - template: default
  - name: hedgedoc
    inherit:
      - template: argocd-app

  - name: speedtest
    chart: bjw-s-labs/app-template
    version: 5.0.1
    inherit:
      - template: gateway
      - template: default
  - name: speedtest
    inherit:
      - template: argocd-app

  - name: it-tools
    chart: bjw-s-labs/app-template
    version: 5.0.1
    inherit:
      - template: gateway
      - template: default
  - name: it-tools
    inherit:
      - template: argocd-app

  - name: immich
    chart: oci://ghcr.io/immich-app/immich-charts/immich
    version: 0.13.1
    inherit:
      - template: default
  - name: immich
    inherit:
      - template: argocd-app

  # TODO: specifying this as direct dependency of immich
  # seems to break the 'common library' chart
  # immich chart is based on too old version of the library chart to
  # use rawResources, thus we need this -enhancements one
  - name: immich-enhancements
    namespace: immich
    chart: bjw-s-labs/app-template
    version: 5.0.1
    inherit:
      - template: vault
      - template: gateway
      - template: default
  - name: immich-enhancements
    values:
      - targetNamespace: immich
    inherit:
      - template: argocd-app

  - name: navidrome
    # TODO: it deserves its own namespace tbh
    namespace: media
    chart: bjw-s-labs/app-template
    version: 5.0.1
    inherit:
      - template: metube
      - template: oidc-secret
      - template: gateway
      - template: default
  - name: navidrome
    values:
      - targetNamespace: media
    inherit:
      - template: argocd-app

  - name: wikijs
    chart: bjw-s-labs/app-template
    version: 4.1.2
    inherit:
      - template: default
  - name: wikijs
    inherit:
      - template: argocd-app

  - name: kopia
    chart: bjw-s-labs/app-template
    version: 4.1.2
    inherit:
      - template: default
  - name: kopia
    inherit:
      - template: argocd-app

  - name: flatnotes
    chart: bjw-s-labs/app-template
    version: 5.0.1
    inherit:
      - template: gateway
      - template: oidc-secret
      - template: default
  - name: flatnotes
    inherit:
      - template: argocd-app

  - name: yopass
    chart: bjw-s-labs/app-template
    version: 5.0.1
    inherit:
      - template: gateway
      - template: default
  - name: yopass
    inherit:
      - template: argocd-app

  - name: silverbullet
    chart: bjw-s-labs/app-template
    version: 4.1.2
    inherit:
      - template: default
  - name: silverbullet
    inherit:
      - template: argocd-app

  - name: mailrise
    chart: bjw-s-labs/app-template
    version: 4.1.2
    inherit:
      - template: default
  - name: mailrise
    inherit:
      - template: argocd-app

  - name: convertx
    chart: bjw-s-labs/app-template
    version: 5.0.1
    inherit:
      - template: gateway
      - template: default
  - name: convertx
    inherit:
      - template: argocd-app

  - name: cyberchef
    chart: bjw-s-labs/app-template
    version: 5.0.1
    inherit:
      - template: gateway
      - template: default
  - name: cyberchef
    inherit:
      - template: argocd-app

  - name: stirling-pdf
    chart: bjw-s-labs/app-template
    version: 5.0.1
    inherit:
      - template: gateway
      - template: default
  - name: stirling-pdf
    inherit:
      - template: argocd-app

  - name: filebrowser-drive
    chart: bjw-s-labs/app-template
    version: 5.0.1
    inherit:
      - template: filebrowser
      - template: gateway
      - template: default
  - name: filebrowser-drive
    inherit:
      - template: argocd-app

  - name: mosquitto
    chart: bjw-s-labs/app-template
    version: 5.0.1
    inherit:
      - template: gateway
      - template: vault
      - template: default
  - name: mosquitto
    inherit:
      - template: argocd-app

  - name: ente
    chart: bjw-s-labs/app-template
    version: 5.0.1
    inherit:
      - template: gateway
      - template: vault
      - template: default
  - name: ente
    inherit:
      - template: argocd-app

  - name: change-detection
    chart: bjw-s-labs/app-template
    version: 5.0.1
    inherit:
      - template: gateway
      - template: oidc-secret
      - template: default
