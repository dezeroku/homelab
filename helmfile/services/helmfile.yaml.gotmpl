---
bases:
  - ../lib/base.yaml.gotmpl

# Per-release configuration for the templates in ../lib: the routes a release
# exposes on the shared gateway, the policies on them, and its Vault secrets.
# See ../lib/values/routes.yaml.gotmpl and ../lib/values/route-policies.yaml.gotmpl
# for the accepted keys.
#
# One file per release under config/, globbed in below, so that adding or
# changing a release touches only its own file. A release inheriting `gateway`
# with no file gets a single `main` route at <release>.<DOMAIN> and no policies.
#
# These are *.yaml.gotmpl, not *.yaml: helmfile only treats an environment
# values file as a Go template when the extension says so, and the hostnames in
# them are built from the DOMAIN env var. A plain .yaml here renders the
# template syntax literally into the hostname.
environments:
  default:
    values:
      - config/*.yaml.gotmpl

---
helmDefaults:
  kubeContext: homeserver

repositories:
  - name: bjw-s-labs
    url: https://bjw-s-labs.github.io/helm-charts
  - name: minio
    url: https://operator.min.io/
  - name: itzg
    url: https://itzg.github.io/minecraft-server-charts/
  - name: zot
    url: http://zotregistry.dev/helm-charts
releases:
  - name: pacoloco
    chart: bjw-s-labs/app-template
    version: 4.1.2
    inherit:
      - template: default
  - name: pacoloco
    inherit:
      - template: argocd-app

  - name: invidious
    chart: bjw-s-labs/app-template
    version: 5.0.1
    labels:
      vaultServiceAccount: invidious-main
    inherit:
      - template: gateway
      - template: vault-secrets
      - template: default
  - name: invidious
    inherit:
      - template: argocd-app

  - name: redbot-main
    chart: bjw-s-labs/app-template
    version: 5.0.1
    inherit:
      - template: filebrowser
      - template: metube
      - template: gateway
      - template: oidc-secret
      - template: default
    values:
      - values/redbot-common.yaml.gotmpl
  - name: redbot-main
    inherit:
      - template: argocd-app

  - name: redbot-premiers
    chart: bjw-s-labs/app-template
    version: 5.0.1
    inherit:
      - template: filebrowser
      - template: metube
      - template: gateway
      - template: oidc-secret
      - template: default
    values:
      - values/redbot-common.yaml.gotmpl
  - name: redbot-premiers
    inherit:
      - template: argocd-app

  - name: netbootxyz
    chart: bjw-s-labs/app-template
    version: 4.1.2
    inherit:
      - template: default
  - name: netbootxyz
    inherit:
      - template: argocd-app

  - name: home-assistant
    chart: bjw-s-labs/app-template
    version: 5.0.1
    inherit:
      - template: gateway
      - template: vault
      - template: default
  - name: home-assistant
    inherit:
      - template: argocd-app

  - name: media-storage
    namespace: media
    chart: bjw-s-labs/app-template
    version: 4.1.2
    inherit:
      - template: default
  - name: media-storage
    values:
      - targetNamespace: media
    inherit:
      - template: argocd-app

  - name: filebrowser-media
    namespace: media
    chart: bjw-s-labs/app-template
    version: 5.0.1
    inherit:
      - template: gateway
      - template: filebrowser
      - template: default
  - name: filebrowser-media
