  - name: zot
    chart: zot/zot
    version: 0.1.98
    inherit:
      - template: default
  - name: zot
    inherit:
      - template: argocd-app

  - name: chrony
    chart: bjw-s-labs/app-template
    version: 4.1.2
    inherit:
      - template: default
  - name: chrony
