---
bases:
  - ../lib/base.yaml.gotmpl

# Per-release gateway configuration for the `gateway` template: the routes a
# release exposes and the policies on them. See ../lib/values/routes.yaml.gotmpl
# and ../lib/values/route-policies.yaml.gotmpl for the accepted keys.
# Releases inheriting `gateway` with no entry here get a single `main` route at
# <release>.<DOMAIN> and no policies.
environments:
  default:
    values:
      - releaseConfig:
          invidious:
            routes:
              main:
                networks: [lan, guest, vpn_main, vpn_guest, vpn_family]
            secrets: [hmac, companion-hmac]
          ryot:
            routes:
              main:
                networks: [lan, guest, cluster, vpn_main, vpn_guest, vpn_family]
            secrets: [admin]
          hedgedoc:
            routes:
              main:
                networks: [lan, guest, cluster, vpn_main, vpn_guest, vpn_family]
          yopass:
            routes:
              main:
                networks: [lan, guest, vpn_main, vpn_guest, vpn_family]
          stirling-pdf:
            routes:
              main:
                networks: [lan, guest, vpn_main, vpn_guest, vpn_family]
          it-tools:
            routes:
              main:
                networks: [lan, guest, vpn_main, vpn_guest, vpn_family]
          homepage:
            routes:
              main:
                hostname: '{{ requiredEnv "DOMAIN" }}'
                networks: [lan, guest, vpn_main, vpn_guest, vpn_family]
          speedtest:
            routes:
              main:
                networks: [lan, guest, vpn_main, vpn_guest, vpn_family]
          convertx:
            routes:
              main:
                networks: [lan, guest, vpn_main, vpn_guest, vpn_family]
          cyberchef:
            routes:
              main: {}
          jellyfin:
            secrets: [ldap-bind-user]
            routes:
              main:
                # TODO: Is cluster really needed here?
                networks: [lan, guest, cluster, vpn_main, vpn_guest, vpn_family]
          lldap:
            secrets: [jwt, key, user]
            routes:
              main:
                networks: [lan, vpn_main]
              # served at ldaps.lldap.<DOMAIN> by the naming convention
              ldaps:
                kind: TCPRoute
          mosquitto:
            routes:
              main:
                kind: TCPRoute

---
helmDefaults:
  kubeContext: homeserver

repositories:
  - name: bjw-s-labs
    url: https://bjw-s-labs.github.io/helm-charts
  - name: minio
    url: https://operator.min.io/
  - name: itzg
    url: https://itzg.github.io/minecraft-server-charts/
  - name: immich
    url: https://immich-app.github.io/immich-charts
  - name: zot
    url: http://zotregistry.dev/helm-charts
releases:
  - name: pacoloco
    chart: bjw-s-labs/app-template
    version: 4.1.2
    inherit:
      - template: default
  - name: pacoloco
    inherit:
      - template: argocd-app

  - name: invidious
    chart: bjw-s-labs/app-template
    version: 5.0.1
    labels:
      vaultServiceAccount: invidious-main
    inherit:
      - template: gateway
      - template: vault-secrets
      - template: default
  - name: invidious
    inherit:
      - template: argocd-app

  - name: redbot-main
    chart: bjw-s-labs/app-template
    version: 4.1.2
    inherit:
      - template: default
    # Using labels as "release values", in anticipation of
    # https://github.com/roboll/helmfile/issues/1329 result
    # This pattern will be shared by all metube deployments for the time being
    labels:
      vaultRole: redbot-main
      vaultSubPath: redbot/main
      appName: redbot-main
      ingressAuth: "allowed_groups=redbot-main-admins"
    values:
      - values/redbot-common.yaml.gotmpl

  - name: redbot-main
    inherit:
      - template: argocd-app

  - name: metube-redbot-main
    namespace: redbot-main
    chart: bjw-s-labs/app-template
    version: 4.1.2
    labels:
      mountSubPath: "metube"
      homepageGroup: RedBot
      existingClaim: redbot-main-localtracks
      ingressAuth: "allowed_groups=redbot-main-admins"
      deleteFileOnThrashCan: true
    inherit:
      - template: default
    values:
      - values/metube-common.yaml.gotmpl

  - name: metube-redbot-main
    values:
      - targetNamespace: redbot-main
    inherit:
      - template: argocd-app

  - name: redbot-premiers
    chart: bjw-s-labs/app-template
    version: 4.1.2
    inherit:
      - template: default
    # Using labels as "release values", in anticipation of
    # https://github.com/roboll/helmfile/issues/1329 result
    # This pattern will be shared by all metube deployments for the time being
    labels:
      vaultRole: redbot-premiers
      vaultSubPath: redbot/premiers
      appName: redbot-premiers
      ingressAuth: "allowed_groups=redbot-premiers-admins"
    values:
      - values/redbot-common.yaml.gotmpl

  - name: redbot-premiers
    inherit:
      - template: argocd-app

  - name: metube-redbot-premiers
    namespace: redbot-premiers
    chart: bjw-s-labs/app-template
    version: 4.1.2
    labels:
      mountSubPath: "metube"
      homepageGroup: RedBot
      existingClaim: redbot-premiers-localtracks
      ingressAuth: "allowed_groups=redbot-premiers-admins"
      deleteFileOnThrashCan: true
    inherit:
      - template: default
    values:
      - values/metube-common.yaml.gotmpl

  - name: metube-redbot-premiers
    values:
      - targetNamespace: redbot-premiers
    inherit:
      - template: argocd-app

  - name: netbootxyz
    chart: bjw-s-labs/app-template
    version: 4.1.2
    inherit:
      - template: default
  - name: netbootxyz
    inherit:
      - template: argocd-app

  - name: home-assistant
    chart: bjw-s-labs/app-template
    version: 4.1.2
    inherit:
      - template: default
  - name: home-assistant
    inherit:
      - template: argocd-app

  - name: media-storage
    namespace: media
    chart: bjw-s-labs/app-template
    version: 4.1.2
    inherit:
      - template: default
  - name: media-storage
    values:
      - targetNamespace: media
    inherit:
      - template: argocd-app

  - name: filebrowser-media
    namespace: media
    chart: bjw-s-labs/app-template
    version: 4.1.2
    inherit:
      - template: default
  - name: filebrowser-media
    values:
      - targetNamespace: media
    inherit:
      - template: argocd-app

  - name: filebrowser-media-readonly
    namespace: media
    chart: bjw-s-labs/app-template
    version: 4.1.2
    inherit:
      - template: default
  - name: filebrowser-media-readonly
    values:
      - targetNamespace: media
    inherit:
      - template: argocd-app

  - name: metube
    namespace: media
    chart: bjw-s-labs/app-template
    version: 4.1.2
    # Using labels as "release values", in anticipation of
    # https://github.com/roboll/helmfile/issues/1329 result
    # This pattern will be shared by all metube deployments for the time being
    labels:
      mountSubPath: metube
      homepageGroup: YT
      existingClaim: media-storage-main
      ingressAuth: "allowed_groups=download-admins,metube"
    inherit:
      - template: default
    values:
      - values/metube-common.yaml.gotmpl
  - name: metube
    values:
      - targetNamespace: media
    inherit:
      - template: argocd-app

  - name: jellyfin
    namespace: media
    chart: bjw-s-labs/app-template
    version: 5.0.1
    inherit:
      - template: gateway
      - template: vault-secrets
      - template: default
  - name: jellyfin
    values:
      - targetNamespace: media
    inherit:
      - template: argocd-app

  - name: minio-core
    chart: minio/tenant
    version: 7.0.0
    inherit:
      - template: default
    dependencies:
      - chart: bjw-s-labs/app-template
        version: 4.1.2
  - name: minio-core
    inherit:
      - template: argocd-app

  - name: minio-private
    chart: minio/tenant
    version: 7.0.0
    inherit:
      - template: default
    dependencies:
      - chart: bjw-s-labs/app-template
        version: 4.1.2
  - name: minio-private
    inherit:
      - template: argocd-app

  - name: homepage
    chart: bjw-s-labs/app-template
    version: 5.0.1
    inherit:
      - template: gateway
      - template: vault
      - template: default
  - name: homepage
    inherit:
      - template: argocd-app

  - name: paperless
    chart: bjw-s-labs/app-template
    version: 4.1.2
    dependencies:
      - chart: oci://registry-1.docker.io/bitnamicharts/redis
        version: 20.1.3
    inherit:
      - template: default
  - name: paperless
    inherit:
      - template: argocd-app

  - name: minecraft
    chart: itzg/minecraft
    version: 4.24.0
    inherit:
      - template: default
    dependencies:
      - chart: bjw-s-labs/app-template
        version: 4.1.2
  - name: minecraft
    inherit:
      - template: argocd-app

  - name: ryot
    chart: bjw-s-labs/app-template
    version: 5.0.1
    inherit:
      - template: gateway
      - template: vault-secrets
      - template: oidc-secret
      - template: default
  - name: ryot
    inherit:
      - template: argocd-app

  - name: hedgedoc
    chart: bjw-s-labs/app-template
    version: 5.0.1
    inherit:
      - template: gateway
      - template: oidc-secret
      - template: default
  - name: hedgedoc
